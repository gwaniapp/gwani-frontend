# Real backend, server-side only — the browser never talks to it directly
# (no CORS headers on the upstream, confirmed live), it goes through this
# app's own same-origin proxy at /api/proxy (see src/app/api/proxy). Defaults
# to https://api.gwanni.app if unset — see src/lib/server/apiProxy.ts.
GWANI_API_BASE_URL=

# Optional — for metadataBase / OpenGraph. Falls back to Vercel's own URL, then
# localhost. Production: https://user.gwanni.app
NEXT_PUBLIC_SITE_URL=
