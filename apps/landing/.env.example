# Optional — every "Sign in" / "Get Started" CTA on this site links to
# apps/web's auth flow. Set this on the landing deployment to apps/web's
# real origin; falls back to apps/web's production domain
# (https://user.gwanni.app) outside local dev, or its local dev port
# (localhost:3000) when running this app on its own machine.
NEXT_PUBLIC_APP_URL=

# Optional — for metadataBase / OpenGraph. Falls back to Vercel's own URL, then
# localhost:3002. Production: https://gwanni.app
NEXT_PUBLIC_SITE_URL=
