# Optional — every "Sign in" / "Get Started" CTA on this site links to
# apps/web's auth flow. Set this on the landing deployment to apps/web's
# real origin; falls back to apps/web's local dev port (localhost:3000).
NEXT_PUBLIC_APP_URL=

# Optional — for metadataBase / OpenGraph. Falls back to Vercel's own URL, then localhost:3002.
NEXT_PUBLIC_SITE_URL=
